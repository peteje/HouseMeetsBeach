# Domain, unter der die App ueber den gemeinsamen Traefik erreichbar ist
DOMAIN=housemeetsbeach.ventovinte.com

# Passwort fuer den Admin-Bereich (/admin.html)
ADMIN_PASSWORD=change-me

# Signaturschluessel fuer Admin-Sessions & Captcha-Tokens
# erzeugen mit: openssl rand -hex 32
SECRET_KEY=change-me-too

# ---- MariaDB (bestehender Container "fhem-db" aus dem fhem_docker-Projekt) ----
# Eigene Datenbank + eigener User darin anlegen, siehe README.md.
MYSQL_HOST=fhem-db
MYSQL_PORT=3306
MYSQL_USER=housemeetsbeach
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=housemeetsbeach
